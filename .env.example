# Required for the booking form to create events on the salon's Google Calendar
# (see app/api/book/route.ts and the README's "Booking form" section for setup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Optional spam protection for the booking form (see README's "Spam protection"
# section for setup). Without these set, the form works with no captcha.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
